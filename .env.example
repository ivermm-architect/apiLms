# ============================================================
# CIEBA LMS - Environment Variables (EXAMPLE)
# Copia este archivo a .env y ajusta los valores.
# NUNCA commitear .env con secretos reales.
# ============================================================

NODE_ENV=development

# -------------------- Postgres --------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cieba
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cieba_lms
DATABASE_URL=postgresql://cieba:change_me@localhost:5432/cieba_lms

# -------------------- Redis --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# -------------------- MinIO (S3-compatible local) --------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change_me
S3_BUCKET=cieba-media
S3_BUCKET_PRIVATE=cieba-private
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# -------------------- API --------------------
API_PORT=3000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:4200,http://localhost:3001
API_GLOBAL_PREFIX=api
# URL pública del frontend (usada en enlaces del frontend).
FRONTEND_URL=http://localhost:4200

# -------------------- Auth (JWT) --------------------
# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_STRING_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_STRING_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# -------------------- Rate Limiting --------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# -------------------- Logging --------------------
LOG_LEVEL=debug
LOG_PRETTY=true

# -------------------- Sentry (opcional) --------------------
SENTRY_DSN=

# -------------------- IA: conexión al proveedor de modelos --------------------
# Conexión COMPARTIDA por todas las funciones de IA (recomendación, sugerencia de
# preguntas, retroalimentación e informe de aprendizaje). Cada función tiene su
# propio flag de activación (abajo). API compatible con OpenAI → sirve para Ollama
# local y OpenAI cambiando solo estas vars.
AI_BASE_URL=http://localhost:11434/v1     # Ollama local. OpenAI: https://api.openai.com/v1
AI_API_KEY=ollama                          # Ollama lo ignora; OpenAI: sk-...
AI_MODEL=llama3.2:3b                        # o gpt-4o-mini con OpenAI
AI_TIMEOUT_MS=30000                         # Ollama local es lento en frío; OpenAI: ~8000 basta

# -------------------- IA: redacción de recomendaciones (OPCIONAL) --------------------
# Capa OPCIONAL de la recomendación de contenido. La DECISIÓN (qué cursos recomendar
# y su orden) es DETERMINISTA; esta IA SÓLO redacta el texto `reason` en lenguaje
# natural. Ante ENABLED=false, error o timeout se usa el texto determinista
# (baseReason): el flujo nunca se rompe.
# Reutiliza AI_BASE_URL / AI_API_KEY / AI_MODEL / AI_TIMEOUT_MS de arriba.
AI_RECOMMENDATION_ENABLED=false

# -------------------- IA: sugerencia de preguntas (OPCIONAL) --------------------
# Capa OPCIONAL para la creación de evaluaciones: PROPONE borradores de preguntas
# (opción múltiple / verdadero-falso / abiertas) a partir de una lección o tema para
# que el docente los revise y edite antes de crearlos. NUNCA persiste ni publica por
# su cuenta. Ante ENABLED=false, error o timeout devuelve []: el docente sigue con el
# alta manual sin diferencia. Reutiliza AI_BASE_URL / AI_API_KEY / AI_MODEL / AI_TIMEOUT_MS.
AI_QUESTION_GEN_ENABLED=false

# -------------------- IA: retroalimentación de respuestas abiertas (OPCIONAL) --------------------
# Capa OPCIONAL para la calificación de respuestas abiertas: PROPONE un borrador de
# retroalimentación en lenguaje natural para que el docente lo revise/edite antes de
# guardarlo. NUNCA califica ni guarda por su cuenta. Ante ENABLED=false, error o timeout
# devuelve null y el docente escribe el comentario manualmente. Reutiliza AI_BASE_URL /
# AI_API_KEY / AI_MODEL / AI_TIMEOUT_MS.
AI_FEEDBACK_ENABLED=false

# -------------------- IA: informe de aprendizaje del estudiante (OPCIONAL) --------------------
# Capa OPCIONAL (tesis §2.9): la IA REDACTA en lenguaje natural un informe de
# fortalezas, debilidades y recomendaciones a partir de HECHOS REALES del estudiante
# (avance por curso + promedios de notas). NO calcula ni muestra cifras psicométricas
# (nada de θ, error estándar ni % de "dominio"). Ante ENABLED=false, error o timeout
# el informe no se genera (generated=false) y la UI lo oculta: el resto del sistema del
# estudiante funciona igual. Reutiliza AI_BASE_URL / AI_API_KEY / AI_MODEL / AI_TIMEOUT_MS.
AI_LEARNING_REPORT_ENABLED=false
